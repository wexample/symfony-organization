{
  "name": "wexample/symfony-organization",
  "description": "A directory of organizations and their legal identity for Symfony",
  "version": "2.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyOrganization\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyOrganization\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/validator": "^7.4 || ^8.0",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-geo": ">=7.0.0",
    "wexample/symfony-remote-vies": ">=2.0.0",
    "wexample/symfony-search": ">=4.1.0",
    "wexample/symfony-user": ">=12.0.1",
    "wexample/php-pseudocode": ">=2.2.0",
    "wexample/symfony-pseudocode": ">=3.0.0",
    "wexample/symfony-media": ">=2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
